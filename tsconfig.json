{
  "compilerOptions": {
    "strict": true,
    "strictBindCallApply": true,
    "outDir": "dist",
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM"],
    "rootDir": "src",
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
}
